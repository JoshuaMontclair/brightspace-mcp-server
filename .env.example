# Your Brightspace credentials (required)
D2L_USERNAME=your_username
D2L_PASSWORD=your_password

# Your institution's Brightspace URL (required)
# Examples: https://purdue.brightspace.com, https://myuni.brightspace.com
D2L_BASE_URL=https://purdue.brightspace.com

# Optional: authenticator-app secret, so the second factor is filled in for you.
# Accepts the base32 setup key or the full otpauth:// link behind the QR code.
# Without it you type the code yourself in the browser window that opens.
# MFA_TOTP_SECRET=otpauth://totp/Issuer:you?secret=XXXX&issuer=Issuer

D2L_SESSION_DIR=~/.d2l-session
D2L_TOKEN_TTL=3600

# Hide the login browser window (default: false).
# Only applies when the login can finish unattended: saved credentials, plus an
# authenticator secret if your school asks for a code. Otherwise the window is
# shown anyway, so you can complete the step.
# D2L_HEADLESS=true

# Course filtering (optional) — applies to all multi-course tools
# D2L_INCLUDE_COURSES=123456,789012       # Whitelist: only show these course IDs (comma-separated)
# D2L_EXCLUDE_COURSES=111111,222222       # Blacklist: hide these course IDs (comma-separated)
# D2L_ACTIVE_ONLY=true                    # Only show active courses (default: true)
